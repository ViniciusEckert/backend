generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Cliente {
  id              Int      @id @default(autoincrement())
  nome            String
  email           String   @unique
  cpf             String   @unique
  data_nascimento String
  telefone        String
  senha           String
  createdAt       DateTime @default(now())
  updateAt        DateTime @updatedAt
  contas          Conta[]  @relation("ClienteToConta")
}

model Agencia {
  id           Int           @id @default(autoincrement())
  nome         String
  numero       String        @unique
  endereco     String
  contas       Conta[]       @relation("AgenciaToConta")
  funcionarios Funcionario[] @relation("AgenciaToFuncionario")
}

model Conta {
  id            Int         @id @default(autoincrement())
  senha         String
  tipo_conta    TipoConta
  saldo         Decimal     @default(0)
  data_abertura DateTime
  agencias      Agencia[]   @relation("AgenciaToConta")
  cartoes       Cartao[]    @relation("CartaoToConta")
  clientes      Cliente[]   @relation("ClienteToConta")
  transacoes    Transacao[] @relation("ContaToTransacao")
}

model Cartao {
  id            Int        @id @default(autoincrement())
  numero_cartao String     @unique
  tipo_cartao   TipoCartao
  cvv           String
  validade      DateTime
  conta         Conta[]    @relation("CartaoToConta")
}

model Transacao {
  id            Int           @id @default(autoincrement())
  tipo          TipoTransacao
  valor         Decimal
  dataTransacao DateTime      @default(now())
  conta         Conta[]       @relation("ContaToTransacao")
}

model Funcionario {
  id       Int       @id @default(autoincrement())
  nome     String
  email    String    @unique
  admin    Boolean
  senha    String
  agencias Agencia[] @relation("AgenciaToFuncionario")
}

enum TipoConta {
  CORRENTE
  POUPANCA
  SALARIO
  UNIVERSITARIA
}

enum TipoCartao {
  CREDITO
  DEBITO
}

enum TipoTransacao {
  DEPOSITO
  SAQUE
  TRANSFERENCIA
  PAGAMENTO
}
